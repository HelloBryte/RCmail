# Copy to .env.local and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string (Neon or any Postgres).
# Neon: https://console.neon.tech → project → Connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk authentication — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Alibaba DashScope API key for Qwen — https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY="sk-..."

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Qwen model id. Defaults to qwen3-8b.
QWEN_MODEL="qwen3-8b"

# Admin dashboard access (/admin). Comma-separated email allowlist, matched
# against the user's primary Clerk email. Unset = nobody has admin access.
ADMIN_EMAILS="you@example.com,teammate@example.com"

# Shared secret for POST /api/billing/activate-business, the manual
# plan-activation endpoint. Unset = the endpoint always returns 403.
ADMIN_SECRET=""

# ---------------------------------------------------------------------------
# Billing — 虎皮椒 (xunhupay) WeChat/Alipay gateway.
# Leave unset to run without billing; the app stays in free-tier mode and
# /api/billing/* returns 503.
# ---------------------------------------------------------------------------

HUPIJIAO_APPID=""
HUPIJIAO_APPSECRET=""

# Prices in CNY, as strings. HUPIJIAO_BUSINESS_PRICE is the fallback for
# whichever of the two is unset. Defaults: monthly 14.9, yearly 99.
HUPIJIAO_MONTHLY_PRICE="14.9"
HUPIJIAO_YEARLY_PRICE="99"
HUPIJIAO_BUSINESS_PRICE=""
